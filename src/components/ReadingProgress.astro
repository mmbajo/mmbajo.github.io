---
interface Props { article?: boolean }
const { article = false } = Astro.props;
---
<div class:list={['reading-progress', { 'article-progress': article }]} data-scope={article ? 'article' : 'page'} role="progressbar" aria-label={article ? 'Article reading progress' : 'Page reading progress'} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden>
  <div class="progress-track">
    <div class="progress-fill"></div>
    <span class="progress-cat" aria-hidden="true">
      <svg class="pixel-cat" width="34" height="22" viewBox="0 0 34 22" fill="none" shape-rendering="crispEdges">
        <g class="cat-pose">
          <path fill="#65452f" d="M1 4h3v6h3V8h13V5h1V2h4v3h3V3h3v3h1v9h-4v2H9v-2H6v-2H3v-2H1Z" />
          <path fill="#dca468" d="M2 5h1v6h4v2H5v-1H2Zm6 4h13V6h2V3h1v4h5V4h1v4h1v6h-4v2H9v-2H8Z" />
          <path fill="#f5d6a3" d="M24 11h7v3h-4v2h-6v-2h3Z" />
          <path fill="#ad7647" d="M10 9h2v3h-2Zm5 0h2v3h-2Zm7-2h2v2h-2Z" />
          <path fill="#332e29" d="M28 8h2v2h-2Zm3 3h2v1h-2Z" />
        </g>
        <g class="cat-legs cat-legs-a">
          <path fill="#65452f" d="M10 15h3v4h-1v2H8v-2h2Zm15 0h3v3h3v3h-5v-3h-1Z" />
          <path fill="#dca468" d="M11 15h2v3h-2Zm15 0h2v3h-2Z" />
        </g>
        <g class="cat-legs cat-legs-b">
          <path fill="#65452f" d="M13 15h3v3h3v3h-5v-3h-1Zm11 0h3v4h-2v2h-4v-2h3Z" />
          <path fill="#dca468" d="M14 15h2v3h-2Zm11 0h2v3h-2Z" />
        </g>
      </svg>
    </span>
  </div>
  {article && <div class="progress-caption" aria-hidden="true"><span>READING</span><span data-progress-percent>00%</span></div>}
</div>

<script>
  const progress = document.querySelector<HTMLElement>('.reading-progress');
  if (progress) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let lastScroll = window.scrollY;
    let queued = false;
    let restTimer: ReturnType<typeof setTimeout>;
    const content = progress.dataset.scope === 'article' ? document.querySelector<HTMLElement>('[data-reading-content]') : null;
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const headings = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));

    const update = () => {
      queued = false;
      const bounds = content?.getBoundingClientRect();
      const start = bounds ? Math.max(0, bounds.top + window.scrollY - 100) : 0;
      const end = bounds ? bounds.bottom + window.scrollY - window.innerHeight : document.documentElement.scrollHeight - window.innerHeight;
      const range = end - start;
      const fraction = range > 0 ? Math.max(0, Math.min(1, (window.scrollY - start) / range)) : 1;
      progress.hidden = !content && range < 1;
      progress.style.setProperty('--progress', String(fraction));
      progress.setAttribute('aria-valuenow', String(Math.round(fraction * 100)));
      const percent = progress.querySelector('[data-progress-percent]');
      if (percent) percent.textContent = `${String(Math.round(fraction * 100)).padStart(2, '0')}%`;
      let active = 0;
      headings.forEach((heading, index) => { if (heading && heading.getBoundingClientRect().top <= 160) active = index; });
      if (fraction === 1) active = links.length - 1;
      links.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const schedule = () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    };
    window.addEventListener('scroll', () => {
      const delta = window.scrollY - lastScroll;
      if (Math.abs(delta) > 0.5) {
        progress.dataset.direction = delta < 0 ? 'left' : 'right';
        if (!reducedMotion.matches) progress.classList.add('is-walking');
        clearTimeout(restTimer);
        restTimer = setTimeout(() => progress.classList.remove('is-walking'), 160);
      }
      lastScroll = window.scrollY;
      schedule();
    }, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('pageshow', schedule);
    reducedMotion.addEventListener('change', () => progress.classList.remove('is-walking'));
    new ResizeObserver(schedule).observe(document.body);
    update();
  }
</script>
