---
import '../styles/cats.css';

interface Props { cat: 'blue-large' | 'blue-medium' | 'tonkinese' }
const { cat } = Astro.props;
const cats = {
  'blue-large': { label: 'Russian Blue · 6 kg', weight: 6, width: 38, height: 24, stride: 440, blink: 6.2, idle: 7.4, outline: '#414e61', coat: '#8d9caf', light: '#bac5d0', shade: '#6a7c94', points: '#6a7c94', eyes: '#bdd996' },
  'blue-medium': { label: 'Russian Blue · 5 kg', weight: 5, width: 34, height: 22, stride: 380, blink: 5.3, idle: 6.6, outline: '#465466', coat: '#96a5b7', light: '#c0cbd5', shade: '#74869e', points: '#74869e', eyes: '#b7d78d' },
  tonkinese: { label: 'Tonkinese · 3.5 kg', weight: 3.5, width: 30, height: 20, stride: 320, blink: 4.7, idle: 5.8, outline: '#514644', coat: '#d2bea1', light: '#ead8ba', shade: '#b19b82', points: '#796257', eyes: '#a7d9d0' },
};
const colors = cats[cat];
const pointed = cat === 'tonkinese';
const face = pointed ? colors.points : colors.coat;

// Reach, contact, gather, and push off. Each pose has near and far paws;
// separate outlines keep the tiny gait readable at its actual display size.
const gait = [
  {
    far: 'M12 15h2v3h3v2h-4v-2h-1Zm11 0h2v4h-3v1h-3v-2h4Z',
    outline: 'M9 15h3v3H9v2H5v-2h3v-1h1Zm16 0h3v2h2v1h3v2h-5v-2h-3Z',
    coat: 'M10 15h2v2h-2Zm16 0h2v2h-2Z',
    paws: 'M5 18h4v1H5Zm23 0h5v1h-5Z',
  },
  {
    far: 'M10 15h2v4h-1v2H8v-2h2Zm15 0h2v3h3v2h-4v-2h-1Z',
    outline: 'M12 15h3v4h-1v2h-4v-2h2Zm12 0h3v4h-1v2h-4v-2h2Z',
    coat: 'M13 15h2v3h-2Zm12 0h2v3h-2Z',
    paws: 'M10 19h4v1h-4Zm12 0h4v1h-4Z',
  },
  {
    far: 'M10 15h2v2h3v2h-5Zm16 0h2v4h-5v-2h3Z',
    outline: 'M12 15h3v2h3v3h-5v-2h-1Zm12 0h3v2h-2v3h-5v-2h4Z',
    coat: 'M13 15h2v2h-2Zm12 0h2v2h-2Z',
    paws: 'M13 18h5v1h-5Zm7 0h5v1h-5Z',
  },
  {
    far: 'M12 15h2v3h-3v2H8v-2h4Zm12 0h2v2h3v3h-4v-2h-1Z',
    outline: 'M10 15h3v4h3v2h-5v-3h-1Zm15 0h3v3h-3v3h-5v-2h4v-2h1Z',
    coat: 'M11 15h2v3h-2Zm15 0h2v2h-2Z',
    paws: 'M11 19h5v1h-5Zm9 0h5v1h-5Z',
  },
];
---
<svg class="pixel-cat" data-cat={cat} data-weight={colors.weight} width={colors.width} height={colors.height} viewBox="0 0 34 22" fill="none" shape-rendering="crispEdges" style={`--cat-stride: ${colors.stride}ms; --cat-blink-speed: ${colors.blink}s; --cat-idle-speed: ${colors.idle}s`}>
  <title>{colors.label}</title>
  <g class="cat-pose">
    <g class="cat-rest-legs">
      <path fill={colors.shade} d="M11 15h2v6H9v-2h2Zm14 0h2v6h-4v-2h2Z" />
      <path fill={colors.outline} d="M9 15h3v4h2v2H9Zm13 0h3v4h2v2h-5Z" />
      <path fill={colors.coat} d="M10 15h2v4h-2Zm13 0h2v4h-2Z" />
      <path fill={colors.points} d="M10 19h4v1h-4Zm13 0h4v1h-4Z" />
    </g>
    <g class="cat-run-legs">
      {gait.map((pose, index) => (
        <g class="cat-gait-frame" style={`--gait-offset: ${index === 0 ? 0 : (4 - index) / 4}`}>
          <path fill={colors.shade} d={pose.far} />
          <path fill={colors.outline} d={pose.outline} />
          <path fill={colors.coat} d={pose.coat} />
          <path fill={colors.points} d={pose.paws} />
        </g>
      ))}
    </g>
    <g class="cat-torso">
      <g class="cat-tail">
        <path fill={colors.outline} d="M1 4h3v5h2v2h3v3H5v-1H3v-2H1Z" />
        <path fill={pointed ? colors.points : colors.coat} d="M2 5h1v5h2v2h3v1H5v-1H3v-1H2Z" />
      </g>
      <path fill={colors.outline} d="M7 9h2V8h12V7h6v9h-5v1H9v-2H7Z" />
      <path fill={colors.coat} d="M8 10h2V9h12v6H10v-1H8Z" />
      <path fill={colors.shade} d="M8 13h2v2h12v1H9v-2H8Z" />
      {cat === 'blue-large' && <path fill={colors.coat} d="M10 15h12v2H10Z" />}
      <path fill={colors.light} d="M10 9h9v1h-9Z" />
      <g class="cat-head">
        <path fill={colors.outline} d="M20 7h1V5h10v1h1v9h-4v2h-7v-3h-1Z" />
        <path fill={face} d="M21 7h3V6h5v1h2v7h-4v2h-5v-2h-1Z" />
        <g class="cat-ear">
          <path fill={colors.outline} d="M21 2h2v1h2v4h-4Z" />
          <path fill={face} d="M22 3h1v1h1v3h-2Z" />
          <path fill="#bd9296" d="M22 4h1v2h-1Z" />
        </g>
        <path fill={colors.outline} d="M28 3h3v4h-3Z" />
        <path fill={face} d="M29 4h1v3h-1Z" />
        <path fill="#bd9296" d="M29 5h1v1h-1Z" />
        <path fill={colors.light} d="M25 12h6v2h-4v2h-5v-1h3Z" />
        <path fill={colors.eyes} d="M27 8h3v2h-3Z" />
        <path fill="#29323a" d="M29 8h1v2h-1Zm2 3h2v1h-2Z" />
        <g class="cat-blink">
          <path fill={face} d="M27 8h3v2h-3Z" />
          <path fill={colors.outline} d="M27 9h3v1h-3Z" />
        </g>
      </g>
    </g>
  </g>
</svg>
