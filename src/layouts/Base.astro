---
import { site } from '../config';
import ReadingProgress from '../components/ReadingProgress.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
}
const { title = site.title, description = site.description, article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const active = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/theme.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    {!article && <ReadingProgress />}
    <a class="skip-link" href="#main">Skip to content</a>
    <div class:list={['site-shell', { 'article-shell': article }]}>
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${site.name} — home`}>
          <span class="prompt" aria-hidden="true">~/</span>mmbajo
        </a>
        <nav aria-label="Main navigation">
          <a href="/blog/" aria-current={active.startsWith('/blog/') ? 'page' : undefined}>Blog</a>
          <a href="/experiments/" aria-current={active.startsWith('/experiments/') ? 'page' : undefined}>Experiments</a>
          <a class="github-nav" href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" hidden>
            <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z" /></svg>
            <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <div>
          <a href="/rss.xml">RSS</a>
          <a href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
          <a href={site.repository}>Source <span aria-hidden="true">↗</span></a>
        </div>
      </footer>
    </div>
  </body>
</html>
