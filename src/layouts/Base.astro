---
import { site, contactEmail, contactProfiles, sameAs } from '../config';
import ReadingProgress from '../components/ReadingProgress.astro';
import EmailLink from '../components/EmailLink.astro';
import '../styles/global.css';
import '../styles/maze.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  /** Absolute-from-root path of the social preview image. */
  ogImage?: string;
  published?: Date;
  modified?: Date;
}
const {
  title = site.title,
  description = site.description,
  article = false,
  ogImage = '/og/default.png',
  published,
  modified,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const active = Astro.url.pathname;
const image = new URL(ogImage, Astro.site);

const person = {
  '@type': 'Person',
  '@id': `${Astro.site}#person`,
  name: site.name,
  alternateName: 'mmbajo',
  url: String(Astro.site),
  jobTitle: 'Research Engineer',
  description: site.description,
  sameAs,
};
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title.replace(` — ${site.name}`, ''),
      description,
      url: String(canonical),
      image: String(image),
      author: person,
      ...(published && { datePublished: published.toISOString() }),
      ...(modified && { dateModified: modified.toISOString() }),
    }
  : { '@context': 'https://schema.org', ...person };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141310" media="(prefers-color-scheme: dark)" />
    <script is:inline src="/theme.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${site.name}`} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <ReadingProgress article={article} />
    <a class="skip-link" href="#main">Skip to content</a>
    <div class:list={['site-shell', { 'article-shell': article }]}>
      <header class="site-header">
        <a class="wordmark" href="/" aria-label={`${site.name} — home`}>
          <span class="prompt" aria-hidden="true">~/</span>mmbajo
        </a>
        <nav aria-label="Main navigation">
          <a href="/blog/" aria-current={active.startsWith('/blog/') ? 'page' : undefined}>Blog</a>
          <a href="/experiments/" aria-current={active.startsWith('/experiments/') ? 'page' : undefined}>Experiments</a>
          <a class="github-nav" href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" hidden>
            <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z" /></svg>
            <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <div>
          {contactEmail && <EmailLink />}
          {contactProfiles.map((profile) => <a href={profile.url}>{profile.label} <span aria-hidden="true">↗</span></a>)}
          <a href="/rss.xml">RSS</a>
          <a href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
          <a href={site.repository}>Source <span aria-hidden="true">↗</span></a>
        </div>
      </footer>
    </div>
  </body>
</html>
