---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<Base title={`${post.data.title} — Mark Bajo`} description={post.data.description} article
  ogImage={`/og/${post.id}.png`} published={post.data.date} modified={post.data.updated}>
  <article class="blog-post">
    <header class="article-header">
      <a class="back-link" href="/blog/">← All posts</a>
      <div class="article-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.example && <span>Interactive example</span>}</div>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
      {post.data.updated && <p class="updated">Updated {formatDate(post.data.updated)}</p>}
    </header>
    <div class="article-layout">
      <TableOfContents sections={sections} />
      <div class="article-body" data-reading-content>
        <div class="prose"><Content /></div>
        <div class="article-end"><a href="/blog/">← Back to blog</a><a href="/rss.xml">Follow via RSS ↗</a></div>
      </div>
    </div>
  </article>
</Base>
